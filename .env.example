# Copy to .env.local. Never commit your filled .env.local or share database passwords in Git.
# Server owner: 127.0.0.1 / metro_app
# Teammates: your database server's Tailscale IPv4 / your individually assigned MySQL account
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=penang_metro
DB_USER=metro_app
DB_PASSWORD=
# Setup computer only: bootstrap a 12-200 character authority registration key.
# Run npm run registration:setup once after the database migration.
# Website instances read the shared database; teammates can leave these blank.
AUTHORITY_REGISTRATION_KEY=
# Setup computer only: optional seed to preserve existing daily team codes.
# An independent random seed is generated if both seed inputs below are empty.
TEAM_CODE_SECRET=
# Optional legacy seed imported only by registration:setup.
LOCAL_SETUP_KEY=
