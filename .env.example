# Copy to .env.local. Never commit your filled .env.local or share database passwords in Git.
# Server owner: 127.0.0.1 / metro_app
# Teammates: your database server's Tailscale IPv4 / your individually assigned MySQL account
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=penang_metro
DB_USER=metro_app
DB_PASSWORD=
# Server-side secret used to derive the daily team registration code.
# Set the same value on every website instance that accepts team registrations.
TEAM_CODE_SECRET=
# Backward-compatible fallback for TEAM_CODE_SECRET on existing installations.
LOCAL_SETUP_KEY=
